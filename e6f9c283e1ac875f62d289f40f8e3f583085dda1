    notification.SubscriptionGateTaskAvailable:    "Task Available subscribers",
    notification.SubscriptionGateTaskDailyDigest:  "Task Daily Digest subscribers",
    notification.SubscriptionGateRiskNotifications: "Risk Notification subscribers",
    notification.SubscriptionGateEvidenceDigest:   "Evidence Digest subscribers",
}
label := gateLabels[gate]
if label == "" {
    label = "Subscribed users" // fallback
}
```

        "file": {
          "x": {
            "enabled": false,
            "source": "ghcr.io/other/plugin-disabled:v1"
          }
        },
        "overlay": null,
        "path": "/plugins/x/enabled",
        "state": "readonly"
      },
      {
        "name": "re-enable, trusted source",
        "trusted": [
          "ghcr.io/trusted/*"
        ],
        "file": {
          "x": {
            "enabled": false,
            "source": "ghcr.io/trusted/p:v1"
          }
        },
        "overlay": null,
        "path": "/plugins/x/enabled",
        "state": "editable"
      },
      {
        "name": "re-enable keeps untrusted and local policies (TestClassifyReenableKeptParts)",
        "trusted": [
          "ghcr.io/trusted/*"
        ],
        "file": {
